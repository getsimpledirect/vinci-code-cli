#!/usr/bin/env node
// Fake git for worker tests. It never accesses a real repository or network.
import { appendFileSync, existsSync, mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const recordFile = process.env.FAKE_GIT_RECORD;
const argv = process.argv.slice(2);
if (recordFile) appendFileSync(recordFile, JSON.stringify(argv) + '\n');
if (argv[0] === 'clone') {
  mkdirSync(argv.at(-1), { recursive: true });
  process.exit(0);
}
const repo = argv[0] === '-C' ? argv[1] : process.cwd();
const command = argv[0] === '-C' ? argv[2] : argv[0];
const rest = argv[0] === '-C' ? argv.slice(3) : argv.slice(1);
if (command === 'show-ref') process.exit(existsSync(join(repo, '.worker-branch')) ? 0 : 1);
if (command === 'checkout' && rest[0] === '-b') writeFileSync(join(repo, '.worker-branch'), rest[1]);
if (command === 'rev-parse' && rest[0] === 'HEAD') process.stdout.write('abc123def456\n');
process.exit(0);
