#!/usr/bin/env node
// Fake vinci for worker tests - records invocation and simulates behavior
import { appendFileSync, existsSync, fstatSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { execSync, spawn } from 'node:child_process';
import { tmpdir } from 'node:os';

const recordFile = process.env.FAKE_VINCI_RECORD || resolve(tmpdir(), 'fake-vinci-invocations.txt');

// #18: the fake launcher's "install" is `$HOME/fake-vinci-version.json` (HOME is the only thing
// the daemon's minimal probe env lets through besides PATH/TMPDIR/LANG):
//   { "version": "0.0.51", "exit": 0, "sleep": 0, "record": "<file>",
//     "flips": [{ "whenExists": "<path>", "version": "0.0.52", "exit": 0 }] }
// The answer is the base fields, overridden in order by every flip whose marker path exists — a
// test makes "the operator updated the launcher between X and Y" happen by pointing a flip at a
// file that Y creates. `record` (when set) receives one line per --version probe with the whole
// env the probe ran under, so a test can prove exactly which variables reached the launcher.
// Missing file => 0.0.0-fake.
const installFile = resolve(process.env.HOME || '/nonexistent', 'fake-vinci-version.json');
function readInstall() {
  let install = { version: '0.0.0-fake', exit: 0, sleep: 0 };
  try {
    install = { ...install, ...JSON.parse(readFileSync(installFile, 'utf8')) };
  } catch {}
  for (const flip of install.flips ?? []) {
    if (flip.whenExists && existsSync(flip.whenExists)) install = { ...install, ...flip, flips: install.flips };
  }
  return install;
}

if (process.argv[2] === '--version') {
  const install = readInstall();
  if (install.record) appendFileSync(install.record, JSON.stringify({ argv: process.argv.slice(2), env: process.env }) + '\n');
  if (install.sleep > 0) await new Promise((resolveSleep) => setTimeout(resolveSleep, install.sleep));
  if (install.exit !== 0) {
    process.stderr.write('fake vinci: version probe failed\n');
    process.exit(install.exit);
  }
  process.stdout.write(`${install.version}\n`);
  process.exit(0);
}

// #18: like the real shim, a launch self-updates BEFORE the payload executes — unless the caller
// set VINCI_UPDATE_DISABLED=1, which the daemon must always do for a task spawn. A test sets
// FAKE_VINCI_SELF_UPDATE_TO to the version an un-disabled launcher would update itself to; the
// invocation record carries the version the payload then actually ran as.
if (process.env.FAKE_VINCI_SELF_UPDATE_TO && process.env.VINCI_UPDATE_DISABLED !== '1') {
  const install = readInstall();
  mkdirSync(resolve(installFile, '..'), { recursive: true });
  writeFileSync(installFile, JSON.stringify({ ...install, version: process.env.FAKE_VINCI_SELF_UPDATE_TO, flips: [] }) + '\n');
}
const executedVersion = readInstall().version;

if (process.env.FAKE_VINCI_FORBIDDEN_CAPABILITY_IDENTITY) {
  for (const name of [
    'VINCI_WORKER_DEBRIS_ROOT_ANCHOR',
    'VINCI_WORKER_DEBRIS_ROOT_ANCHOR_SHA256',
    'VINCI_WORKER_DEBRIS_AUTHORITY_ADAPTER',
    'VINCI_WORKER_DEBRIS_AUTHORITY_ADAPTER_SHA256',
    'VINCI_WORKER_DEBRIS_AUTHORITY_CAPABILITY_FD',
    'VINCI_WORKER_DEBRIS_AUTHORITY_SERVICE_SHA256',
    'VINCI_WORKER_DEBRIS_AUTHORITY_PUBLIC_KEY_SPKI',
  ]) {
    if (Object.hasOwn(process.env, name)) throw new Error(`task inherited debris authority setting: ${name}`);
  }
  try {
    const stat = fstatSync(3);
    if (`${stat.dev}:${stat.ino}` === process.env.FAKE_VINCI_FORBIDDEN_CAPABILITY_IDENTITY) {
      throw new Error('task inherited the debris authority capability descriptor');
    }
  } catch (error) {
    if (error?.code !== 'EBADF') throw error;
  }
}

const sessionDir = process.argv.indexOf('--session-dir') >= 0 ? process.argv[process.argv.indexOf('--session-dir') + 1] : undefined;
const sessionId = process.argv.indexOf('--session-id') >= 0 ? process.argv[process.argv.indexOf('--session-id') + 1] : undefined;

// Record the invocation
const invocation = {
  argv: process.argv.slice(2),
  timestamp: new Date().toISOString(),
  pid: process.pid,
  version: executedVersion,
  updateDisabled: process.env.VINCI_UPDATE_DISABLED ?? null,
};
appendFileSync(recordFile, JSON.stringify(invocation) + '\n');
// If there's a session dir and session ID, write the outcome JSONL
if (sessionDir && sessionId) {
  const sessPath = resolve(sessionDir, sessionId);
  mkdirSync(sessPath, { recursive: true });
  const sessionFile = resolve(sessPath, 'session.jsonl');

  // Check for behavior flags
  const sleepMs = process.env.FAKE_VINCI_SLEEP ? parseInt(process.env.FAKE_VINCI_SLEEP, 10) : 0;
  const waitForSigterm = process.env.FAKE_VINCI_WAIT_FOR_SIGTERM === '1';
  const signalDeadlineMs = Number(process.env.FAKE_VINCI_SIGNAL_DEADLINE_MS);
  const outcome = process.env.FAKE_VINCI_OUTCOME || 'DONE';
  const failExit = process.env.FAKE_VINCI_EXIT !== undefined ? parseInt(process.env.FAKE_VINCI_EXIT, 10) : 0;
  const writeUsage = process.env.FAKE_VINCI_USAGE === '1';

  const startupDelayMs = Number(process.env.FAKE_VINCI_STARTUP_DELAY_MS) || 0;
  if (startupDelayMs > 0) await new Promise((resolveStartup) => setTimeout(resolveStartup, startupDelayMs));

  // By default, make a real commit (fixture for a successful run).
  // Use FAKE_VINCI_NO_COMMIT=1 to simulate a run with no commits (e.g. for #28 tests).
  const noCommit = process.env.FAKE_VINCI_NO_COMMIT === '1';
  if (!noCommit && !process.env.FAKE_VINCI_COMMIT_FILE) {
    try {
      // Check if we're in a git repo
      try {
        execSync('git rev-parse --git-dir', { cwd: process.cwd(), stdio: 'ignore' });
      } catch {
        throw new Error('not a git repo');
      }
      // Configure git if needed
      try {
        execSync('git config user.email "test@example.com"', { cwd: process.cwd(), stdio: 'ignore' });
        execSync('git config user.name "Test User"', { cwd: process.cwd(), stdio: 'ignore' });
      } catch {
        // Ignore if already configured
      }
      // Create and commit a file
      const workFile = resolve('VINCI_WORK_DONE');
      writeFileSync(workFile, 'completed by vinci\n');
      execSync('git add VINCI_WORK_DONE', { cwd: process.cwd() });
      execSync('git commit -m "vinci fixture: work completed"', { cwd: process.cwd(), stdio: 'ignore' });
    } catch (e) {
      // Silently fail if not a git repo or git not available
    }
  }

    appendFileSync(sessionFile, JSON.stringify({ type: 'session', id: sessionId }) + '\n');
  const outcomeEntry = (cost) => ({
    type: 'custom',
    customType: 'vinci-task-outcome',
    data: {
      schemaVersion: 1,
      taskId: sessionId,
      state: outcome,
      reason: process.env.FAKE_VINCI_REASON || 'fixture outcome',
      changedFiles: [],
      verificationStatus: 'passed',
      verificationCommand: 'fixture check',
      usage: {
        modelCalls: cost > 0 ? 1 : 0,
        inputTokens: 0,
        outputTokens: 0,
        cachedTokens: 0,
        cacheWriteTokens: 0,
        reasoningTokens: 0,
        estimatedCostUsd: cost,
        providers: ['fixture'],
        models: ['fixture/model'],
      },
      recordedAt: new Date().toISOString(),
    },
  });

  if (outcome && process.env.FAKE_VINCI_SKIP_OUTCOME !== '1') {
    appendFileSync(sessionFile, JSON.stringify(outcomeEntry(0)) + '\n');
  }

  // Write usage if requested
  if (writeUsage) {
    const fixturePath = process.env.FAKE_VINCI_SESSION_FIXTURE;
    if (fixturePath) {
      const fixtureEntries = readFileSync(fixturePath, 'utf8')
        .replaceAll('SESSION_ID', sessionId)
        .split('\n')
        .filter((line) => line && JSON.parse(line).type !== 'session')
        .join('\n');
      appendFileSync(sessionFile, `${fixtureEntries}\n`);
    } else {
      appendFileSync(sessionFile, JSON.stringify(outcomeEntry(9.99)) + '\n');
    }
  }

  if (process.env.FAKE_VINCI_WORKTREE_BLOCKER === '1') writeFileSync(resolve('BLOCKER.md'), 'working tree only\n');
  // Wave 1B output modes: FAKE_VINCI_COMMIT_FILE=<name> makes the fake agent produce real work —
  // a new file committed in the task checkout (cwd) — so patch/artifact/branch publishing has
  // something to carry. FAKE_VINCI_UNTRACKED_FILE=<name> leaves an untracked file behind instead.
  if (process.env.FAKE_VINCI_COMMIT_FILE) {
    const { execFileSync } = await import('node:child_process');
    writeFileSync(resolve(process.env.FAKE_VINCI_COMMIT_FILE), `produced by fake vinci ${sessionId}\n`);
    const git = (...args) => execFileSync('git', args, { stdio: 'pipe' });
    git('config', 'user.email', 'fake@vinci.test');
    git('config', 'user.name', 'fake vinci');
    git('add', '--', process.env.FAKE_VINCI_COMMIT_FILE);
    git('commit', '-qm', `fake vinci: ${process.env.FAKE_VINCI_COMMIT_FILE}`);
  }
  if (process.env.FAKE_VINCI_UNTRACKED_FILE) writeFileSync(resolve(process.env.FAKE_VINCI_UNTRACKED_FILE), 'untracked deliverable\n');

  // A lease-loss fixture must stay alive until the daemon actually signals it.
  // A fixed sleep can finish before two renewal timeout budgets have elapsed.
  if (sleepMs > 0 || waitForSigterm) {
    if (waitForSigterm && (!Number.isFinite(signalDeadlineMs) || signalDeadlineMs <= 0)) {
      throw new Error('The fixture signal deadline must be finite and positive; set FAKE_VINCI_SIGNAL_DEADLINE_MS.');
    }
    if (process.env.FAKE_VINCI_DESCENDANT_READY_FILE) {
      const readyFile = process.env.FAKE_VINCI_DESCENDANT_READY_FILE;
      const descendant = spawn(process.execPath, ['--input-type=module', '-e', `
        import { appendFileSync, writeFileSync } from 'node:fs';
        process.on('SIGTERM', () => appendFileSync(${JSON.stringify(recordFile)}, 'DESCENDANT_SIGTERM\\n'));
        writeFileSync(${JSON.stringify(readyFile)}, String(process.pid));
        setInterval(() => {}, 1000);
      `], { stdio: 'ignore' });
      descendant.unref();
      const deadline = Date.now() + 5000;
      while (!existsSync(readyFile) || Number(readFileSync(readyFile, 'utf8')) !== descendant.pid) {
        if (Date.now() >= deadline) throw new Error('The fixture descendant did not become ready within 5000 ms; inspect the child process.');
        await new Promise((resolveWait) => setTimeout(resolveWait, 25));
      }
    }
    process.on("SIGTERM", () => {
      appendFileSync(recordFile, "SIGTERM\n");
      if (process.env.FAKE_VINCI_IGNORE_SIGTERM !== '1') process.exit(143);
    });
    if (process.env.FAKE_VINCI_PULSE_FILE) {
      let pulse = 0;
      setInterval(() => writeFileSync(process.env.FAKE_VINCI_PULSE_FILE, String(++pulse)), 50);
    }
    if (process.env.FAKE_VINCI_READY_FILE) writeFileSync(process.env.FAKE_VINCI_READY_FILE, `${process.pid}\n`);
    if (waitForSigterm) {
      await new Promise((_, reject) => setTimeout(() => reject(new Error(`The fixture task did not receive SIGTERM within ${signalDeadlineMs} ms; inspect the daemon stop and lease renewal paths.`)), signalDeadlineMs));
    } else {
      await new Promise((resolveSleep) => setTimeout(resolveSleep, sleepMs));
    }
  }

  if (process.env.FAKE_VINCI_USAGE_AT_EXIT === '1') {
    await new Promise((resolveWait) => setTimeout(resolveWait, 100));
    appendFileSync(sessionFile, JSON.stringify(outcomeEntry(9.99)) + '\n');
  }

  // Exit with code if requested
  if (failExit !== 0) {
    process.exit(failExit);
  }
}

if (process.env.FAKE_VINCI_RUN_EXIT_MARKER) writeFileSync(process.env.FAKE_VINCI_RUN_EXIT_MARKER, String(process.pid));
process.exit(0);
