#!/usr/bin/env node
// Fake vinci for worker tests - records invocation and simulates behavior
import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';

const recordFile = process.env.FAKE_VINCI_RECORD || '/tmp/fake-vinci-invocations.txt';

// `vinci --version` (#18): answered BEFORE the invocation is recorded so getVinciCalls() keeps
// counting only real runs. The version comes from FAKE_VINCI_VERSION_FILE (read on every call, so a
// test can change it between tasks) or FAKE_VINCI_VERSION, default 0.0.0-fake. Each probe is
// appended to FAKE_VINCI_VERSION_RECORD (when set) with the env the daemon passed, so a test can
// prove VINCI_UPDATE_DISABLED=1 reached the launcher. FAKE_VINCI_VERSION_EXIT=<n> fails the probe;
// FAKE_VINCI_VERSION_SLEEP=<ms> hangs it.
if (process.argv[2] === '--version') {
  if (process.env.FAKE_VINCI_VERSION_RECORD) {
    appendFileSync(
      process.env.FAKE_VINCI_VERSION_RECORD,
      JSON.stringify({ argv: process.argv.slice(2), updateDisabled: process.env.VINCI_UPDATE_DISABLED ?? null }) + '\n',
    );
  }
  const sleep = parseInt(process.env.FAKE_VINCI_VERSION_SLEEP || '0', 10);
  if (sleep > 0) await new Promise((resolveSleep) => setTimeout(resolveSleep, sleep));
  const exit = parseInt(process.env.FAKE_VINCI_VERSION_EXIT || '0', 10);
  if (exit !== 0) {
    process.stderr.write('fake vinci: version probe failed\n');
    process.exit(exit);
  }
  let version = process.env.FAKE_VINCI_VERSION || '0.0.0-fake';
  if (process.env.FAKE_VINCI_VERSION_FILE) {
    try {
      version = readFileSync(process.env.FAKE_VINCI_VERSION_FILE, 'utf8').trim() || version;
    } catch {}
  }
  process.stdout.write(`${version}\n`);
  process.exit(0);
}
const sessionDir = process.argv.indexOf('--session-dir') >= 0 ? process.argv[process.argv.indexOf('--session-dir') + 1] : undefined;
const sessionId = process.argv.indexOf('--session-id') >= 0 ? process.argv[process.argv.indexOf('--session-id') + 1] : undefined;

// Record the invocation
const invocation = {
  argv: process.argv.slice(2),
  timestamp: new Date().toISOString(),
};
appendFileSync(recordFile, JSON.stringify(invocation) + '\n');

// If there's a session dir and session ID, write the outcome JSONL
if (sessionDir && sessionId) {
  const sessPath = resolve(sessionDir, sessionId);
  mkdirSync(sessPath, { recursive: true });
  const sessionFile = resolve(sessPath, 'session.jsonl');

  // Check for behavior flags
  const sleepMs = process.env.FAKE_VINCI_SLEEP ? parseInt(process.env.FAKE_VINCI_SLEEP, 10) : 0;
  const outcome = process.env.FAKE_VINCI_OUTCOME || 'DONE';
  const failExit = process.env.FAKE_VINCI_EXIT !== undefined ? parseInt(process.env.FAKE_VINCI_EXIT, 10) : 0;
  const writeUsage = process.env.FAKE_VINCI_USAGE === '1';

  appendFileSync(sessionFile, JSON.stringify({ type: 'session', id: sessionId }) + '\n');
  const outcomeEntry = (cost) => ({
    type: 'custom',
    customType: 'vinci-task-outcome',
    data: {
      schemaVersion: 1,
      taskId: sessionId,
      state: outcome,
      reason: process.env.FAKE_VINCI_REASON || 'fixture outcome',
      changedFiles: [],
      verificationStatus: 'passed',
      verificationCommand: 'fixture check',
      usage: {
        modelCalls: cost > 0 ? 1 : 0,
        inputTokens: 0,
        outputTokens: 0,
        cachedTokens: 0,
        cacheWriteTokens: 0,
        reasoningTokens: 0,
        estimatedCostUsd: cost,
        providers: ['fixture'],
        models: ['fixture/model'],
      },
      recordedAt: new Date().toISOString(),
    },
  });

  if (outcome) appendFileSync(sessionFile, JSON.stringify(outcomeEntry(0)) + '\n');

  // Write usage if requested
  if (writeUsage) {
    const fixturePath = process.env.FAKE_VINCI_SESSION_FIXTURE;
    if (fixturePath) {
      const fixtureEntries = readFileSync(fixturePath, 'utf8')
        .replaceAll('SESSION_ID', sessionId)
        .split('\n')
        .filter((line) => line && JSON.parse(line).type !== 'session')
        .join('\n');
      appendFileSync(sessionFile, `${fixtureEntries}\n`);
    } else {
      appendFileSync(sessionFile, JSON.stringify(outcomeEntry(9.99)) + '\n');
    }
  }

  // #18: simulate the launcher self-updating DURING a run — the next `--version` answers differently.
  if (process.env.FAKE_VINCI_SELF_UPDATE_TO && process.env.FAKE_VINCI_VERSION_FILE) {
    writeFileSync(process.env.FAKE_VINCI_VERSION_FILE, `${process.env.FAKE_VINCI_SELF_UPDATE_TO}\n`);
  }

  if (process.env.FAKE_VINCI_WORKTREE_BLOCKER === '1') writeFileSync(resolve('BLOCKER.md'), 'working tree only\n');

  // Sleep if requested
  if (sleepMs > 0) {
    process.on('SIGTERM', () => {
      appendFileSync(recordFile, 'SIGTERM\n');
      process.exit(143);
    });
    await new Promise((resolveSleep) => setTimeout(resolveSleep, sleepMs));
  }

  if (process.env.FAKE_VINCI_USAGE_AT_EXIT === '1') {
    await new Promise((resolveWait) => setTimeout(resolveWait, 100));
    appendFileSync(sessionFile, JSON.stringify(outcomeEntry(9.99)) + '\n');
  }

  // Exit with code if requested
  if (failExit !== 0) {
    process.exit(failExit);
  }
}

process.exit(0);
